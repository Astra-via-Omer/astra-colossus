# Reuse the existing managed provider secret. Never commit real values.
ASTRA_PROVIDER_CONFIG_JSON={"key":"REPLACE","model":"YOUR_AVAILABLE_MODEL","allowedEmails":[]}
PORT=4002
COLOSSUS_ORIGIN=http://localhost:4002
# Local persistent engine registry; omit when using Supabase in production.
COLOSSUS_ENGINE_FILE=.astra-private/engines.json
# Optional independent client and admin credentials; default client key is the provider key.
# COLOSSUS_API_KEYS_JSON=["SERVICE_KEY"]
# COLOSSUS_ADMIN_KEY=ADMIN_SERVICE_KEY
# COLOSSUS_ENGINE_BUCKET=YOUR_PRIVATE_ENGINE_BUCKET
# Existing account backend, for the console and persistent registry.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_ANON_KEY=PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_KEY
# Optional routes: server-controlled destinations, never supplied by callers.
# COLOSSUS_ROUTES_JSON={"astra-default":{"baseUrl":"https://api.deepseek.com","model":"YOUR_AVAILABLE_MODEL","keyEnv":"DEEPSEEK_API_KEY","capabilities":["text"],"defaults":{"thinking":{"type":"disabled"}}}}
COLOSSUS_MAX_INFLIGHT=16
COLOSSUS_TIMEOUT_MS=90000
